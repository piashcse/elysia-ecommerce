{
  "name": "elysia-ecommerce",
  "version": "1.0.0",
  "packageManager": "bun@1.4.5",
  "description": "A modern e-commerce platform built with Elysia.js",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun run scripts/test-db.ts && NODE_ENV=test DB_NAME=${TEST_DB_NAME:-elysia_ecom_test} bun test src/tests",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "build": "bun build src/index.ts --outfile dist/app.js --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docs:snapshot": "bun run scripts/snapshot-openapi.ts",
    "docs:generate": "bun run scripts/generate-docs.ts",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "docs:fix-pages": "bash scripts/fix-pages-source.sh"
  },
  "keywords": [
    "elysia",
    "ecommerce",
    "typescript",
    "bun",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@elysia/cors": "2.0.0-rc.1",
    "@elysia/jwt": "2.0.0-rc.0",
    "@elysia/openapi": "2.0.0-rc.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "elysia": "2.0.0-rc.6",
    "exact-mirror": "^1.2.8",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "rate-limiter-flexible": "^11.6.1",
    "typebox": "^1.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.4.5",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
