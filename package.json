{
  "name": "elysia-ecommerce",
  "version": "1.0.0",
  "description": "A modern e-commerce platform built with Elysia.js",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test src/tests",
    "build": "bun build src/index.ts --outfile dist/app.js --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "elysia",
    "ecommerce",
    "typescript",
    "bun",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.8",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.28",
    "pg": "^8.20.0",
    "rate-limiter-flexible": "^9.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/validator": "^13.15.10",
    "bun-types": "^1.3.11",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}