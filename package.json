{
  "name": "elysia-ecommerce",
  "version": "1.0.0",
  "description": "A modern e-commerce platform built with Elysia.js",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test src/tests",
    "build": "bun build src/index.ts --outfile dist/app.js --target bun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "elysia",
    "ecommerce",
    "typescript",
    "bun",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^latest",
    "@elysiajs/eden": "^latest",
    "@elysiajs/jwt": "^latest",
    "@elysiajs/openapi": "^1.4.11",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "elysia": "^latest",
    "pg": "^8.11.3",
    "rate-limiter-flexible": "^4.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/dotenv": "^8.2.3",
    "@types/node": "^latest",
    "@types/pg": "^8.10.9",
    "@types/validator": "^13.11.7",
    "bun-types": "^latest",
    "drizzle-kit": "^0.31.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}