# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce_db
DB_SSL=false
# Used by `bun run test`; created/migrated automatically.
TEST_DB_NAME=elysia_ecom_test

# Auth (required)
# Generate a strong secret, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005
TRUST_PROXY=false

# Logging (fatal|error|warn|info|debug|trace|silent)
LOG_LEVEL=info

# Commerce
TAX_RATE=0
PAYMENT_SIMULATE_FAILURE_RATE=0
PAYMENT_WEBHOOK_SECRET=change-me
REVIEW_AUTO_APPROVE=true

# Email verification / password reset
REQUIRE_EMAIL_VERIFICATION=false
MAIL_FROM=no-reply@example.com
# Optional HTTP mail transport. Receives { from, to, subject, text, html }.
# MAIL_WEBHOOK_URL=https://mail.example.com/send

# Email outbox retries / background worker
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_INTERVAL_MS=60000
EMAIL_MAX_ATTEMPTS=5
